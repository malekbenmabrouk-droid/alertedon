# Base URL used by the browser to reach the API.
# Keep "/api" in development: Vite forwards it to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Where the FastAPI backend runs (development proxy only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Data source on first launch: "demo" (built-in sample data) or "api".
VITE_DEFAULT_SOURCE=demo
